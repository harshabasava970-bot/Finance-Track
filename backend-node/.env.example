PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/financetrack?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_at_least_64_chars_long
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Email (Brevo / Gmail / any SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_smtp_password
SMTP_FROM="FinanceTrack <noreply@financetrack.app>"
