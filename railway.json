{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd backend && mvn package -DskipTests"
  },
  "deploy": {
    "startCommand": "java -Dserver.port=$PORT -jar backend/target/financetrack-backend-1.0.0.jar",
    "healthcheckPath": "/actuator/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
